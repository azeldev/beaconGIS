  <connection>
   <sender>button_box</sender>
   <signal>accepted()</signal>
   <receiver>ChangeDetectorDialogBase</receiver>
   <slot>accept()</slot>
  </connection>
  <connection>
   <sender>button_box</sender>
   <signal>rejected()</signal>
